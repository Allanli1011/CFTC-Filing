# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (file-based, no setup needed)
# Switch to PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/cftc
DATABASE_URL=sqlite:///./data/cftc.db

# ── CFTC / Socrata API ────────────────────────────────────────────────────────
# Optional: increases Socrata rate limits (register at data.cftc.gov)
SOCRATA_APP_TOKEN=

# ── Alerts ────────────────────────────────────────────────────────────────────
# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ── Analysis ──────────────────────────────────────────────────────────────────
# Percentile lookback window (weeks) for COT Index
COT_INDEX_LOOKBACK=156   # 3 years

# Signal thresholds
EXTREME_LONG_THRESHOLD=80    # Percentile above which positioning is extreme long
EXTREME_SHORT_THRESHOLD=20   # Percentile below which positioning is extreme short

# ── Scheduler ─────────────────────────────────────────────────────────────────
# CFTC releases COT every Friday ~3:30 PM Eastern
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/New_York
